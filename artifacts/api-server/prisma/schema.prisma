generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────

model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  domain                String   @unique
  logoUrl               String?
  onboardingSmsTemplate String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  areas         Area[]
  programs      Program[]
  users         User[]
  patients      Patient[]
  smsComs       SmsCommunication[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  programEnrollments ProgramEnrollment[]
  appointments       Appointment[]

  @@map("tenants")
}

// ─────────────────────────────────────────
// AREA
// ─────────────────────────────────────────

model Area {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  clinics                  Clinic[]
  patients                 Patient[]
  doctorPatientAssignments DoctorPatientAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("areas")
}

// ─────────────────────────────────────────
// CLINIC
// ─────────────────────────────────────────

model Clinic {
  id        String    @id @default(uuid())
  tenantId  String
  areaId    String
  name      String
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  area                     Area                      @relation(fields: [areaId], references: [id])
  patients                 Patient[]
  userClinicAssignments    UserClinicAssignment[]
  doctorPatientAssignments DoctorPatientAssignment[]
  appointments             Appointment[]

  @@unique([areaId, name])
  @@index([tenantId])
  @@index([areaId])
  @@map("clinics")
}

// ─────────────────────────────────────────
// ROLE & PERMISSION
// ─────────────────────────────────────────

model Role {
  id          String    @id @default(uuid())
  tenantId    String?
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]
  users           User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────
// USER (STAFF)
// ─────────────────────────────────────────

model User {
  id                   String     @id @default(uuid())
  tenantId             String
  roleId               String
  firstName            String
  lastName             String
  email                String     @unique
  password             String
  mobile               String?
  avatarUrl            String?
  status               UserStatus @default(ACTIVE)
  lastLoginAt          DateTime?
  resetToken           String?
  resetTokenExpiresAt  DateTime?
  emailVerified        Boolean    @default(false)
  verificationToken    String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?
  createdBy            String?
  updatedBy            String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  clinicAssignments    UserClinicAssignment[]
  programAssignments   UserProgramAssignment[]
  doctorAssignments    DoctorPatientAssignment[]
  journeyEvents        PatientJourneyEvent[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  uploadedFiles        FileUpload[]
  refreshTokens        RefreshToken[]
  appointments         Appointment[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model UserClinicAssignment {
  id        String    @id @default(uuid())
  userId    String
  clinicId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@map("user_clinic_assignments")
}

model UserProgramAssignment {
  id        String    @id @default(uuid())
  userId    String
  programId String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@map("user_program_assignments")
}

// ─────────────────────────────────────────
// PROGRAM
// ─────────────────────────────────────────

model Program {
  id             String    @id @default(uuid())
  tenantId       String
  channelId      Int?
  name           String
  logoUrl        String?
  activationCode String
  priority       Int       @default(0)
  tags           String[]  @default([])
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  patients               Patient[]
  userProgramAssignments UserProgramAssignment[]
  programEnrollments     ProgramEnrollment[]

  @@unique([tenantId, activationCode])
  @@index([tenantId])
  @@map("programs")
}

// ─────────────────────────────────────────
// PATIENT
// ─────────────────────────────────────────

model Patient {
  id                    String        @id @default(uuid())
  tenantId              String
  programId             String
  clinicId              String
  areaId                String
  nhsNumber             String
  title                 String?
  firstName             String
  lastName              String
  email                 String?
  mobile                String
  altMobile             String?
  gender                Gender?
  dob                   DateTime?
  address               String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String?       @default("UK")
  ethnicity             String?
  latitude              String?
  longitude             String?
  status                PatientStatus @default(INACTIVE)
  accountStatus         AccountStatus @default(ACTIVATE)
  patientGroup          PatientGroup?
  userType              UserType?
  emisId                String?
  isTest                Boolean       @default(false)
  optOut                Boolean       @default(false)
  optOutAt              DateTime?
  registrationDate      DateTime?
  activationDate        DateTime?
  firstConsultationDate DateTime?
  inviteSentCount       Int           @default(0)
  inviteSentAt          DateTime?
  isDischarge           Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  createdBy             String?
  updatedBy             String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  program Program @relation(fields: [programId], references: [id])
  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  area    Area    @relation(fields: [areaId], references: [id])

  gpDetails             PatientGpDetails?
  referrals             PatientReferral[]
  journeyEvents         PatientJourneyEvent[]
  doctorAssignments     DoctorPatientAssignment[]
  smsCommunications     SmsCommunication[]
  fileUploads           FileUpload[]
  onboardingLogs        AccountOnboardingLog[]
  programEnrollments    ProgramEnrollment[]
  appointments          Appointment[]

  @@unique([tenantId, nhsNumber])
  @@index([tenantId])
  @@index([clinicId])
  @@index([areaId])
  @@index([programId])
  @@map("patients")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum AccountStatus {
  ACTIVATE
  DEACTIVATE
}

enum PatientGroup {
  NEW_PATIENT
  REFERRED_FOR_REVIEW
  TRANSITION_FROM_CAMHS
  TRANSITION_ADULT
}

enum UserType {
  PRIVATE
  RTC
  ICB_CONTRACT
}

model PatientGpDetails {
  id                     String   @id @default(uuid())
  patientId              String   @unique
  gpName                 String?
  gpOrgName              String?
  gpNationalPracticeCode String?
  gpEmail                String?
  gpAddress              String?
  gpPostCode             String?
  gpCity                 String?
  gpDistrict             String?
  gpCountry              String?
  gpSelected             Boolean  @default(false)
  icbSelected            Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_gp_details")
}

model PatientReferral {
  id             String    @id @default(uuid())
  patientId      String
  referralSource String?
  referralText   String?
  referralDate   DateTime?
  contract       String?
  contractOther  String?
  createdAt      DateTime  @default(now())
  createdBy      String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_referrals")
}

model PatientJourneyEvent {
  id        String        @id @default(uuid())
  patientId String
  status    JourneyStatus
  notes     String?
  actedBy   String
  createdAt DateTime      @default(now())

  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  actedByUser User    @relation(fields: [actedBy], references: [id])

  @@index([patientId])
  @@map("patient_journey_events")
}

enum JourneyStatus {
  NEW
  PSI
  DISCHARGE
  MEDICATION_REQUIRED
}

// ─────────────────────────────────────────
// DOCTOR-PATIENT ASSIGNMENT
// ─────────────────────────────────────────

model DoctorPatientAssignment {
  id           String    @id @default(uuid())
  tenantId     String
  areaId       String
  clinicId     String
  doctorId     String
  patientId    String
  isTemp       Boolean   @default(false)
  firstLoginAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  area    Area    @relation(fields: [areaId], references: [id])
  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  doctor  User    @relation(fields: [doctorId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@index([doctorId])
  @@index([patientId])
  @@map("doctor_patient_assignments")
}

// ─────────────────────────────────────────
// SMS COMMUNICATION
// ─────────────────────────────────────────

model SmsCommunication {
  id           String    @id @default(uuid())
  tenantId     String
  patientId    String?
  mobile       String
  messageText  String
  twilioSid    String?
  status       SmsStatus @default(QUEUED)
  attemptCount Int       @default(0)
  sentAt       DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  patient Patient? @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@index([twilioSid])
  @@map("sms_communications")
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
}

// ─────────────────────────────────────────
// FILE UPLOAD
// ─────────────────────────────────────────

model FileUpload {
  id         String    @id @default(uuid())
  tenantId   String
  patientId  String
  uploaderId String
  fileKey    String
  fileUrl    String
  caseBlock  String?
  fileType   String?
  isTest     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  patient  Patient @relation(fields: [patientId], references: [id])
  uploader User    @relation(fields: [uploaderId], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@map("file_uploads")
}

// ─────────────────────────────────────────
// ACCOUNT ONBOARDING LOG
// ─────────────────────────────────────────

model AccountOnboardingLog {
  id            String   @id @default(uuid())
  tenantId      String
  uploadBatchId String?
  uploaderId    String?
  programId     String?
  patientId     String?
  nhsId         String?
  mobile        String?
  email         String?
  status        String
  statusCode    Int?
  statusMessage String?
  source        String?
  isTest        Boolean  @default(false)
  createdAt     DateTime @default(now())

  patient Patient? @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@index([uploadBatchId])
  @@map("account_onboarding_logs")
}

// ─────────────────────────────────────────
// AUDIT LOG (append-only)
// ─────────────────────────────────────────

model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String
  entityType  String
  entityId    String
  action      AuditAction
  actorId     String?
  beforeValue Json?
  afterValue  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

// ─────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([isRead])
  @@map("notifications")
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

// ─────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// DATABASE SYNC QUEUE & DLQ
// ─────────────────────────────────────────

model SyncQueueItem {
  id        String   @id @default(uuid())
  entityType String
  entityId   String
  operation  String
  payload    Json
  retryCount Int      @default(0)
  status     SyncQueueStatus @default(PENDING)
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([entityType, entityId])
  @@map("sync_queue_items")
}

model DeadLetterQueueItem {
  id        String   @id @default(uuid())
  entityType String
  entityId   String
  operation  String
  payload    Json
  retryCount Int
  error      String
  createdAt  DateTime @default(now())

  @@map("dead_letter_queue_items")
}

enum SyncQueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────
// DATABASE SYNC AUDIT
// ─────────────────────────────────────────

model DatabaseSyncAudit {
  id              String   @id @default(uuid())
  entityType      String
  entityId        String
  operation       String
  postgresStatus  String
  mysqlStatus     String
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@map("database_sync_audit")
}

// ─────────────────────────────────────────
// PROGRAM ENROLLMENT
// ─────────────────────────────────────────

model ProgramEnrollment {
  id          String           @id @default(uuid())
  tenantId    String
  patientId   String
  programId   String
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  status      EnrollmentStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([programId])
  @@map("program_enrollments")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────
// APPOINTMENTS
// ─────────────────────────────────────────

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  patientId       String
  doctorId        String
  clinicId        String
  appointmentDate DateTime
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@index([clinicId])
  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

