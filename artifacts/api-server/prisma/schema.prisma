generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                      String                    @id @default(uuid())
  name                    String
  domain                  String                    @unique
  logoUrl                 String?
  onboardingSmsTemplate   String?
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  appointments            Appointment[]
  areas                   Area[]
  auditLogs               AuditLog[]
  careTasks               CareTask[]
  consultations           Consultation[]
  notifications           Notification[]
  outcomeMetrics          OutcomeMetric[]
  outcomes                PatientOutcome[]
  patients                Patient[]
  programEnrollments      ProgramEnrollment[]
  programs                Program[]
  smsComs                 SmsCommunication[]
  user_tenant_assignments user_tenant_assignments[]

  @@map("tenants")
}

model Area {
  id                       String                    @id @default(uuid())
  tenantId                 String
  name                     String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinics                  Clinic[]
  doctorPatientAssignments DoctorPatientAssignment[]
  patients                 Patient[]
  programs                 Program[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("areas")
}

model Clinic {
  id                       String                    @id @default(uuid())
  tenantId                 String
  areaId                   String
  name                     String
  address                  String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  appointments             Appointment[]
  area                     Area                      @relation(fields: [areaId], references: [id])
  consultations            Consultation[]
  doctorPatientAssignments DoctorPatientAssignment[]
  patients                 Patient[]
  programs                 Program[]
  userClinicAssignments    UserClinicAssignment[]

  @@unique([areaId, name])
  @@index([tenantId])
  @@index([areaId])
  @@map("clinics")
}

model Role {
  id                      String                    @id @default(uuid())
  tenantId                String?
  name                    String
  description             String?
  isSystem                Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  rolePermissions         RolePermission[]
  user_tenant_assignments user_tenant_assignments[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  module          String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                      String                    @id @default(uuid())
  firstName               String
  lastName                String
  email                   String                    @unique
  password                String
  mobile                  String?
  avatarUrl               String?
  status                  UserStatus                @default(ACTIVE)
  lastLoginAt             DateTime?
  resetToken              String?
  resetTokenExpiresAt     DateTime?
  emailVerified           Boolean                   @default(false)
  verificationToken       String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  createdBy               String?
  updatedBy               String?
  appointments            Appointment[]
  auditLogs               AuditLog[]
  createdTasks            CareTask[]                @relation("TaskCreator")
  assignedTasks           CareTask[]                @relation("TaskAssignee")
  consultations           Consultation[]
  doctorAssignments       DoctorPatientAssignment[]
  uploadedFiles           FileUpload[]
  notifications           Notification[]
  journeyEvents           PatientJourneyEvent[]
  recordedOutcomes        PatientOutcome[]          @relation("OutcomeDoctor")
  refreshTokens           RefreshToken[]
  clinicAssignments       UserClinicAssignment[]
  programAssignments      UserProgramAssignment[]
  user_tenant_assignments user_tenant_assignments[]

  @@index([email])
  @@map("users")
}

model UserClinicAssignment {
  id        String    @id @default(uuid())
  userId    String
  clinicId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@map("user_clinic_assignments")
}

model UserProgramAssignment {
  id        String    @id @default(uuid())
  userId    String
  programId String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  program   Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@map("user_program_assignments")
}

model Program {
  id                     String                  @id @default(uuid())
  tenantId               String
  channelId              Int?
  name                   String
  logoUrl                String?
  activationCode         String
  priority               Int                     @default(0)
  tags                   String[]                @default([])
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  description            String?
  areaId                 String?
  clinicId               String?
  outcomes               PatientOutcome[]
  patients               Patient[]
  programEnrollments     ProgramEnrollment[]
  area                   Area?                   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  clinic                 Clinic?                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userProgramAssignments UserProgramAssignment[]

  @@unique([tenantId, activationCode])
  @@index([tenantId])
  @@index([areaId])
  @@index([clinicId])
  @@map("programs")
}

model Patient {
  id                    String                    @id @default(uuid())
  tenantId              String
  programId             String
  clinicId              String
  areaId                String
  nhsNumber             String
  title                 String?
  firstName             String
  lastName              String
  email                 String?
  mobile                String
  altMobile             String?
  gender                Gender?
  dob                   DateTime?
  address               String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String?                   @default("UK")
  ethnicity             String?
  latitude              String?
  longitude             String?
  status                PatientStatus             @default(INACTIVE)
  accountStatus         AccountStatus             @default(ACTIVATE)
  patientGroup          PatientGroup?
  userType              UserType?
  emisId                String?
  isTest                Boolean                   @default(false)
  optOut                Boolean                   @default(false)
  optOutAt              DateTime?
  registrationDate      DateTime?
  activationDate        DateTime?
  firstConsultationDate DateTime?
  inviteSentCount       Int                       @default(0)
  inviteSentAt          DateTime?
  isDischarge           Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  deletedAt             DateTime?
  createdBy             String?
  updatedBy             String?
  lastCalculatedAt      DateTime?
  riskLevel             RiskLevel?                @default(LOW)
  riskScore             Float?                    @default(0)
  onboardingLogs        AccountOnboardingLog[]
  appointments          Appointment[]
  careTasks             CareTask[]
  consultations         Consultation[]
  doctorAssignments     DoctorPatientAssignment[]
  fileUploads           FileUpload[]
  gpDetails             PatientGpDetails?
  journeyEvents         PatientJourneyEvent[]
  outcomes              PatientOutcome[]
  referrals             PatientReferral[]
  area                  Area                      @relation(fields: [areaId], references: [id])
  clinic                Clinic                    @relation(fields: [clinicId], references: [id])
  program               Program                   @relation(fields: [programId], references: [id])
  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programEnrollments    ProgramEnrollment[]
  smsCommunications     SmsCommunication[]

  @@unique([tenantId, nhsNumber])
  @@index([tenantId])
  @@index([clinicId])
  @@index([areaId])
  @@index([programId])
  @@index([riskLevel])
  @@map("patients")
}

model PatientGpDetails {
  id                     String   @id @default(uuid())
  patientId              String   @unique
  gpName                 String?
  gpOrgName              String?
  gpNationalPracticeCode String?
  gpEmail                String?
  gpAddress              String?
  gpPostCode             String?
  gpCity                 String?
  gpDistrict             String?
  gpCountry              String?
  gpSelected             Boolean  @default(false)
  icbSelected            Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  patient                Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_gp_details")
}

model PatientReferral {
  id             String    @id @default(uuid())
  patientId      String
  referralSource String?
  referralText   String?
  referralDate   DateTime?
  contract       String?
  contractOther  String?
  createdAt      DateTime  @default(now())
  createdBy      String?
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_referrals")
}

model PatientJourneyEvent {
  id          String        @id @default(uuid())
  patientId   String
  status      JourneyStatus
  notes       String?
  actedBy     String?
  createdAt   DateTime      @default(now())
  actedByUser User?         @relation(fields: [actedBy], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_journey_events")
}

model DoctorPatientAssignment {
  id           String    @id @default(uuid())
  tenantId     String
  areaId       String
  clinicId     String
  doctorId     String
  patientId    String
  isTemp       Boolean   @default(false)
  firstLoginAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  area         Area      @relation(fields: [areaId], references: [id])
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  doctor       User      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([doctorId])
  @@index([patientId])
  @@map("doctor_patient_assignments")
}

model SmsCommunication {
  id           String    @id @default(uuid())
  tenantId     String
  patientId    String?
  mobile       String
  messageText  String
  twilioSid    String?
  status       SmsStatus @default(QUEUED)
  attemptCount Int       @default(0)
  sentAt       DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  patient      Patient?  @relation(fields: [patientId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([twilioSid])
  @@map("sms_communications")
}

model FileUpload {
  id         String    @id @default(uuid())
  tenantId   String
  patientId  String
  uploaderId String?
  fileKey    String
  fileUrl    String
  caseBlock  String?
  fileType   String?
  isTest     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploader   User?     @relation(fields: [uploaderId], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@map("file_uploads")
}

model AccountOnboardingLog {
  id            String   @id @default(uuid())
  tenantId      String
  uploadBatchId String?
  uploaderId    String?
  programId     String?
  patientId     String?
  nhsId         String?
  mobile        String?
  email         String?
  status        String
  statusCode    Int?
  statusMessage String?
  source        String?
  isTest        Boolean  @default(false)
  createdAt     DateTime @default(now())
  patient       Patient? @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@index([uploadBatchId])
  @@map("account_onboarding_logs")
}

model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String
  entityType  String
  entityId    String
  action      AuditAction
  actorId     String?
  beforeValue Json?
  afterValue  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  actor       User?       @relation(fields: [actorId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([isRead])
  @@map("notifications")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model SyncQueueItem {
  id         String          @id @default(uuid())
  entityType String
  entityId   String
  operation  String
  payload    Json
  retryCount Int             @default(0)
  status     SyncQueueStatus @default(PENDING)
  error      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status])
  @@index([entityType, entityId])
  @@map("sync_queue_items")
}

model DeadLetterQueueItem {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  operation  String
  payload    Json
  retryCount Int
  error      String
  createdAt  DateTime @default(now())

  @@map("dead_letter_queue_items")
}

model DatabaseSyncAudit {
  id             String   @id @default(uuid())
  entityType     String
  entityId       String
  operation      String
  postgresStatus String
  mysqlStatus    String
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@map("database_sync_audit")
}

model ProgramEnrollment {
  id          String           @id @default(uuid())
  tenantId    String
  patientId   String
  programId   String
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  status      EnrollmentStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  program     Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([programId])
  @@map("program_enrollments")
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  patientId       String
  doctorId        String
  clinicId        String
  appointmentDate DateTime
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  clinic          Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor          User              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consultation    Consultation?

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@index([clinicId])
  @@map("appointments")
}

model Consultation {
  id                   String      @id @default(uuid())
  tenantId             String
  patientId            String
  appointmentId        String      @unique
  doctorId             String
  clinicId             String
  chiefComplaint       String
  symptoms             String
  observations         String
  diagnosis            String
  treatmentPlan        String
  medications          String
  followUpInstructions String
  consultationDate     DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?
  appointment          Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clinic               Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor               User        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient              Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@index([clinicId])
  @@index([appointmentId])
  @@map("consultations")
}

model OutcomeMetric {
  id          String           @id @default(uuid())
  tenantId    String
  code        String
  name        String
  category    String
  unit        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outcomes    PatientOutcome[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("outcome_metrics")
}

model PatientOutcome {
  id              String        @id @default(uuid())
  tenantId        String
  patientId       String
  programId       String
  doctorId        String?
  baselineValue   Float
  currentValue    Float
  targetValue     Float
  measuredAt      DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  outcomeMetricId String
  doctor          User?         @relation("OutcomeDoctor", fields: [doctorId], references: [id])
  outcomeMetric   OutcomeMetric @relation(fields: [outcomeMetricId], references: [id])
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  program         Program       @relation(fields: [programId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([programId])
  @@index([outcomeMetricId])
  @@map("patient_outcomes")
}

model CareTask {
  id          String       @id @default(uuid())
  tenantId    String
  patientId   String
  assignedBy  String?
  assignedTo  String?
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime
  status      TaskStatus   @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  creator     User?        @relation("TaskCreator", fields: [assignedBy], references: [id])
  assignee    User?        @relation("TaskAssignee", fields: [assignedTo], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([assignedTo])
  @@index([dueDate])
  @@index([status])
  @@map("care_tasks")
}

model user_tenant_assignments {
  id        String     @id
  userId    String
  tenantId  String
  roleId    String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime
  roles     Role       @relation(fields: [roleId], references: [id])
  tenants   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum AccountStatus {
  ACTIVATE
  DEACTIVATE
}

enum PatientGroup {
  NEW_PATIENT
  REFERRED_FOR_REVIEW
  TRANSITION_FROM_CAMHS
  TRANSITION_ADULT
}

enum UserType {
  PRIVATE
  RTC
  ICB_CONTRACT
}

enum JourneyStatus {
  NEW
  PSI
  DISCHARGE
  MEDICATION_REQUIRED
  CONSULTATION_COMPLETED
  APPOINTMENT_COMPLETED
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum SyncQueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
